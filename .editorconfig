root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,xml,cmake}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

# Historical evidence is copied byte for byte.
[results/**]
insert_final_newline = unset
end_of_line = unset
charset = unset
